# Infisical Configuration
# Get these values from your Infisical dashboard
INFISICAL_TOKEN=your-token-here  # Service token from Infisical
INFISICAL_HOST=https://app.infisical.com  # Default Infisical host, change if using self-hosted
PROJECT_ID=your-project-id  # Project ID from Infisical dashboard
ENVIRONMENT=development  # Options: development, staging, production

# API Configuration
DEBUG=True  # Set to False in production

# Required Infisical Secrets to Set Up:
# - SECRET_KEY: Used for JWT encoding and security
# - DATABASE_URL: Your database connection string 